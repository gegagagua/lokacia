{
  "extends": "@lokacia/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "geojson"
    ]
  },
  "include": [
    "src",
    ".storybook"
  ]
}